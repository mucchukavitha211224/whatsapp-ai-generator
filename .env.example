# ==============================================================================
# WhatsApp AI Website Generator - Configuration Template
# Copy this file to a new file named '.env' and fill in your actual credentials.
# ==============================================================================

# Flask configuration
FLASK_SECRET_KEY=super-secret-dev-key-change-me

# Groq API Credentials (Get a free key at https://console.groq.com/)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# Twilio Credentials (Get keys at https://www.twilio.com/console)
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# The Twilio Sandbox WhatsApp number (usually +14155238886)
TWILIO_WHATSAPP_NUMBER=+14155238886

# Netlify Personal Access Token (Get a token under User Settings > Applications > Personal Access Tokens)
NETLIFY_AUTH_TOKEN=your_netlify_personal_access_token_here
# Optional: Deploy to a single dedicated site (leave blank to dynamically spin up a new site for each website request!)
NETLIFY_SITE_ID=
